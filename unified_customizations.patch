index 00000000..3e91f037
--- /dev/null
+++ b/restore.sh
@@ -0,0 +1,30 @@
+#!/bin/bash
+
+# Exit immediately if a command exits with a non-zero status.
+set -e
+
+echo "Starting the restore script..."
+
+# Find all .back files and restore them safely
+# Using find with -print0 and a while read loop with a null delimiter
+# is the safest way to handle filenames with spaces or special characters.
+find . -type f -name "*.back" -print0 | while IFS= read -r -d '' backup_file; do
+    original_file=$(echo "$backup_file" | sed 's/\.back$//')
+    if [ -f "$backup_file" ]; then # Check if the backup file actually exists
+        echo "Restoring '$original_file' from '$backup_file'..."
+        mv -f "$backup_file" "$original_file"
+    else
+        echo "Warning: Backup file '$backup_file' not found, skipping."
+    fi
+done
+
+# Remove log files and other artifacts created by modification scripts
+ARTIFACTS=("branding_changed_files.txt")
+for artifact in "${ARTIFACTS[@]}"; do
+    if [ -f "$artifact" ]; then
+        echo "Removing artifact '$artifact'..."
+        rm -f "$artifact"
+    fi
+done
+
+echo "Restore script finished successfully."
diff --git a/translate-i18n.sh b/translate-i18n.sh
new file mode 100755
index 00000000..b4a08f38
--- /dev/null
+++ b/translate-i18n.sh
@@ -0,0 +1,39 @@
+#!/bin/bash
+
+# Este script reemplaza la palabra "Chatwoot" por "Sempitecno" en todos
+# los archivos de internacionalización (i18n) de la aplicación.
+# Crea un archivo de respaldo .back para cada archivo modificado.
+
+# Salir inmediatamente si un comando falla.
+set -e
+
+# --- Configuración ---
+I18N_DIRECTORY="app/javascript/dashboard/i18n/"
+SEARCH_WORD="Chatwoot"
+REPLACE_WORD="Sempitecno"
+
+echo "Iniciando el script de traducción de i18n..."
+
+# --- Lógica Principal ---
+# Verificar si el directorio de i18n existe.
+if [ ! -d "$I18N_DIRECTORY" ]; then
+    echo "Advertencia: Directorio '$I18N_DIRECTORY' no encontrado. Omitiendo."
+    exit 0
+fi
+
+# Encontrar todos los archivos .json en el directorio de i18n y sus subdirectorios.
+# Para cada archivo, usar sed para reemplazar la palabra (ignorando mayúsculas y minúsculas)
+# y crear un archivo de respaldo (si aún no existe).
+find "$I18N_DIRECTORY" -type f -name "*.json" -print0 | while IFS= read -r -d '' file; do
+    echo "Procesando '$file'..."
+    if [ ! -f "${file}.back" ]; then
+        cp "$file" "${file}.back"
+    fi
+    sed -i "s/${SEARCH_WORD}/${REPLACE_WORD}/gi" "$file"
+done
+
+# --- Limpieza ---
+# Eliminar cualquier archivo .back vacío que sed pueda haber creado.
+find "$I18N_DIRECTORY" -type f -name "*.back" -size 0 -delete
+
+echo "Traducción de i18n completada. Se han creado archivos de respaldo .back para todos los archivos modificados."
